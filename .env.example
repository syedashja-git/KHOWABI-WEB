# Database: Cloudflare D1 (recommended, never pauses). When all three are set, D1 is used.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_API_TOKEN=
# Or Supabase (used only when the D1 values above are empty)
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SECRET_KEY=
ADMIN_USERNAME=admin
ADMIN_PASSWORD=
RESEND_API_KEY=
EMAIL_FROM=
NOTIFICATION_EMAIL=infosyedashja@gmail.com

# In auto mode Gmail takes priority. Use a Google App Password.
GMAIL_USER=infosyedashja@gmail.com
GMAIL_APP_PASSWORD=

SITE_URL=https://khowabi.com
# auto preserves existing Gmail behavior; use resend after domain verification
EMAIL_PROVIDER=auto
REPLY_TO_EMAIL=infosyedashja@gmail.com
